# Kopier til .env og fyll inn. ALDRI sjekk inn .env (ligger i .gitignore).

# --- IMAP: én konto (enkel form) ---
IMAP_HOST=imap.figment.no
IMAP_PORT=993
IMAP_USER=broker@figment.no
IMAP_PASSWORD=app-passord-her
IMAP_MAILBOX=INBOX

# --- IMAP: flere kontoer (overstyrer feltene over hvis satt) ---
# JSON-liste. Hver konto: email, host, user (valgfri), password, port, mailbox.
# IMAP_ACCOUNTS=[{"email":"broker@figment.no","host":"imap.figment.no","password":"xxx"},{"email":"oppdrag@figment.no","host":"imap.figment.no","password":"yyy"}]

# true (standard) = bare e-post fra domener i sender_domains plukkes opp
FILTER_DOMAINS=true

# --- Supabase (prosjekt: Brokerforesporsler) ---
SUPABASE_URL=https://wocrhuiyzrckxihqzrla.supabase.co
# service_role-nøkkel (hemmelig!) — Supabase → Project Settings → API keys
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=attachments

# --- Anthropic (matchscore) ---
ANTHROPIC_API_KEY=
# claude-opus-5-5 (standard) eller claude-haiku-5-5 (billigere for dette volumet)
ANTHROPIC_MODEL=claude-opus-5-5

# --- Kjøring ---
MAX_FETCH=50
